<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="PanelBackground" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E20"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#FF252527"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FF262628"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FF363638"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FF333336"/>
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#FF3D3D40"/>
    <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#FF47474A"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#FF404043"/>
    <SolidColorBrush x:Key="TabBarBackground" Color="#FF2A2A2C"/>
    <SolidColorBrush x:Key="Separator" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="TrackBackground" Color="#FF48484A"/>
    <SolidColorBrush x:Key="ToggleOff" Color="#FF48484A"/>
    <SolidColorBrush x:Key="ToggleKnob" Color="#FFE8E8ED"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#FF333336"/>
    <SolidColorBrush x:Key="HoverOverlay" Color="#14FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F2F7"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFA1A1A6"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#FF6E6E73"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/>

    <!-- Accents (system palette) -->
    <Color x:Key="AccentColor">#FF0A84FF</Color>
    <SolidColorBrush x:Key="Accent" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF3395FF"/>
    <SolidColorBrush x:Key="AccentSubtle" Color="#FF16365C"/>
    <SolidColorBrush x:Key="Green" Color="#FF30D158"/>
    <SolidColorBrush x:Key="GreenSubtle" Color="#33208A3C"/>
    <SolidColorBrush x:Key="Orange" Color="#FFFF9F0A"/>
    <SolidColorBrush x:Key="Red" Color="#FFFF453A"/>
    <SolidColorBrush x:Key="Yellow" Color="#FFFFD60A"/>
    <SolidColorBrush x:Key="Cyan" Color="#FF64D2FF"/>
    <SolidColorBrush x:Key="Mint" Color="#FF63E6E2"/>
    <SolidColorBrush x:Key="Pink" Color="#FFFF375F"/>
    <SolidColorBrush x:Key="Purple" Color="#FFBF5AF2"/>
</ResourceDictionary>
