<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="PanelBackground" Color="#FFF2F2F5"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#FFD1D1D6"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#FFEBEBEF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FFE0E0E5"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FFE9E9ED"/>
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#FFE0E0E5"/>
    <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#FFD5D5DA"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#FFD1D1D6"/>
    <SolidColorBrush x:Key="TabBarBackground" Color="#FFE6E6EA"/>
    <SolidColorBrush x:Key="Separator" Color="#FFDCDCE0"/>
    <SolidColorBrush x:Key="TrackBackground" Color="#FFD1D1D6"/>
    <SolidColorBrush x:Key="ToggleOff" Color="#FFD1D1D6"/>
    <SolidColorBrush x:Key="ToggleKnob" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="HoverOverlay" Color="#0F000000"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF6C6C70"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#FF98989D"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/>

    <!-- Accents (system palette, light variants) -->
    <Color x:Key="AccentColor">#FF007AFF</Color>
    <SolidColorBrush x:Key="Accent" Color="#FF007AFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF1A88FF"/>
    <SolidColorBrush x:Key="AccentSubtle" Color="#FFD6E8FF"/>
    <SolidColorBrush x:Key="Green" Color="#FF00702E"/>
    <SolidColorBrush x:Key="GreenSubtle" Color="#3334C759"/>
    <SolidColorBrush x:Key="Orange" Color="#FFAD4D00"/>
    <SolidColorBrush x:Key="Red" Color="#FFAD1419"/>
    <SolidColorBrush x:Key="Yellow" Color="#FF8F5C00"/>
    <SolidColorBrush x:Key="Cyan" Color="#FF006E8A"/>
    <SolidColorBrush x:Key="Mint" Color="#FF007066"/>
    <SolidColorBrush x:Key="Pink" Color="#FFAD0F57"/>
    <SolidColorBrush x:Key="Purple" Color="#FF8944AB"/>
</ResourceDictionary>
